{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "go run",
            "type": "shell",
            "command": "go run ./cmd/hump",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": ["$go"]
        },
        {
            "label": "go build",
            "type": "shell",
            "command": "go build -o .bin/hump ./cmd/hump",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$go"]
        }
    ]
}
