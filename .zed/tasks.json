[
    {
        "label": "Run",
        "command": "task run",
        "env": {
            "DATABASE_URL": "postgres://hump:hump@localhost:5437/hump?sslmode=disable",
            "TELEMETRY_PORT": "9100"
        },
        "show_command": false,
        "hide": "on_success",
        "reveal": "always",
        "reveal_target": "dock",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "cwd": "$ZED_WORKTREE_ROOT"
    },
    {
        "label": "Run Cleanup",
        "command": "task run:cleanup",
        "env": {
            "DATABASE_URL": "postgres://hump:hump@localhost:5437/hump?sslmode=disable"
        },
        "show_command": false,
        "hide": "never",
        "reveal": "always",
        "reveal_target": "dock",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "cwd": "$ZED_WORKTREE_ROOT"
    },
    {
