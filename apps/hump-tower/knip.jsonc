{
    "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
    "ignoreIssues": {
        // Generated by `bun run generate:openapi`: analyzed so its imports resolve, but its unused
        // exports are not ours to fix. app/routeTree.gen.ts is handled by the TanStack Router plugin.
        "src/shared/api/generated/**": ["exports", "types", "duplicates"],
        // The UI kit keeps a complete component API on purpose (subcomponents, variants, prop types),
        // whether or not the app uses every piece today. Unused files and dependencies are still checked.
        "src/shared/ui/**": ["exports", "types"],
        // The documented contract of the live slice (src/shared/live/AGENTS.md): the stream factory,
        // backoff constants and their types are exported for consumers even where none import them yet.
        "src/shared/live/index.ts": ["exports", "types"],
        // LiveStreamOpen and LiveOperation are used only in their own file and through the contract above,
        // so they stay exported for index.ts to re-export.
        "src/shared/live/{stream,types}.ts": ["types"]
    },
    "ignoreDependencies": [
        // Not imported anywhere: rsbuild loads it by name when RSDOCTOR=true (the `analyze` script).
        "@rsdoctor/rspack-plugin"
    ]
}
