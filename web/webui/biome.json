{
    "$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": false
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**/app/**/*",
            "**/src/**/*",
            "**/rsbuild.config.ts",
            "!**/app/routeTree.gen.ts",
            "!**/app/styles.css",
            "!**/src/shared/api/openapi.json",
            "!**/src/shared/api/generated"
        ]
    },
    "formatter": {
        "enabled": true,
        "lineWidth": 120,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "recommended": true,
                "organizeImports": {
                    "level": "on",
                    "options": {
                        "identifierOrder": "natural",
                        "groups": [
                            ["@tanstack/**"],
                            ":BLANK_LINE:",
                            ["react", "react-dom", "react-dom/**", "react-*"],
                            ":BLANK_LINE:",
                            [":BUN:", ":NODE:"],
                            ":BLANK_LINE:",
                            [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:"],
                            ":BLANK_LINE:",
                            ["@/app/**", "@/pages/**", "@/widgets/**", "@/features/**", "@/entities/**", "@/shared/**"],
                            ":BLANK_LINE:",
                            ":ALIAS:",
                            ":BLANK_LINE:",
                            ":PATH:",
                            ":BLANK_LINE:",
                            ":URL:",
                            "**"
                        ]
                    }
                }
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all",
            "semicolons": "asNeeded"
        }
    }
}
