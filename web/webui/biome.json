{
    "$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": false
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**/app/**/*",
            "**/src/**/*",
            "**/rsbuild.config.ts",
            "!**/app/routeTree.gen.ts",
            "!**/app/styles.css",
            "!**/src/shared/api/openapi.json",
            "!**/src/shared/api/generated"
        ]
    },
    "overrides": [
        {
            "includes": ["src/shared/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": [
                                            "@/app",
                                            "@/app/**",
                                            "@/pages",
                                            "@/pages/**",
                                            "@/widgets",
                                            "@/widgets/**",
                                            "@/features",
                                            "@/features/**",
                                            "@/entities",
                                            "@/entities/**"
                                        ],
                                        "message": "FSD layer direction: app > pages > widgets > features > entities > shared. A layer may only import from layers below it."
                                    },
                                    {
                                        "group": [
                                            "@/app/**",
                                            "@/entities/*/*/**",
                                            "!@/entities/*/@x/*",
                                            "!@/entities/*/*/@x/*",
                                            "@/features/*/**",
                                            "!@/features/*/@x/*",
                                            "@/widgets/*/**",
                                            "!@/widgets/*/@x/*",
                                            "@/pages/*/**",
                                            "!@/pages/*/@x/*",
                                            "@/shared/api/**",
                                            "@/shared/live/**",
                                            "@/shared/prometheus/**",
                                            "@/shared/state/**",
                                            "@/shared/theme/**",
                                            "@/shared/utils/**",
                                            "@/shared/ui/*/**",
                                            "!@/shared/ui/charts/*"
                                        ],
                                        "message": "FSD public API: import a slice through its barrel ('@/entities/statistics/delivered', '@/shared/ui/button'), never a file inside it. Cross-slice imports on the same layer go through '@x'."
                                    },
                                    {
                                        "group": ["../../*", "../../**"],
                                        "message": "FSD: a relative import may not leave its own slice. Use the '@/<layer>/<slice>' barrel instead."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["src/entities/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": [
                                            "@/app",
                                            "@/app/**",
                                            "@/pages",
                                            "@/pages/**",
                                            "@/widgets",
                                            "@/widgets/**",
                                            "@/features",
                                            "@/features/**"
                                        ],
                                        "message": "FSD layer direction: app > pages > widgets > features > entities > shared. A layer may only import from layers below it."
                                    },
                                    {
                                        "group": ["@/entities/**", "!@/entities/*/@x/*", "!@/entities/*/*/@x/*"],
                                        "message": "FSD: slices on the same layer are isolated. Expose a cross-import API at '<slice>/@x/<consumer>.ts' and import that."
                                    },
                                    {
                                        "group": [
                                            "@/app/**",
                                            "@/entities/*/*/**",
                                            "!@/entities/*/@x/*",
                                            "!@/entities/*/*/@x/*",
                                            "@/features/*/**",
                                            "!@/features/*/@x/*",
                                            "@/widgets/*/**",
                                            "!@/widgets/*/@x/*",
                                            "@/pages/*/**",
                                            "!@/pages/*/@x/*",
                                            "@/shared/api/**",
                                            "@/shared/live/**",
                                            "@/shared/prometheus/**",
                                            "@/shared/state/**",
                                            "@/shared/theme/**",
                                            "@/shared/utils/**",
                                            "@/shared/ui/*/**",
                                            "!@/shared/ui/charts/*"
                                        ],
                                        "message": "FSD public API: import a slice through its barrel ('@/entities/statistics/delivered', '@/shared/ui/button'), never a file inside it. Cross-slice imports on the same layer go through '@x'."
                                    },
                                    {
                                        "group": ["../../*", "../../**"],
                                        "message": "FSD: a relative import may not leave its own slice. Use the '@/<layer>/<slice>' barrel instead."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["src/features/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": [
                                            "@/app",
                                            "@/app/**",
                                            "@/pages",
                                            "@/pages/**",
                                            "@/widgets",
                                            "@/widgets/**"
                                        ],
                                        "message": "FSD layer direction: app > pages > widgets > features > entities > shared. A layer may only import from layers below it."
                                    },
                                    {
                                        "group": ["@/features/**", "!@/features/*/@x/*"],
                                        "message": "FSD: slices on the same layer are isolated. Expose a cross-import API at '<slice>/@x/<consumer>.ts' and import that."
                                    },
                                    {
                                        "group": [
                                            "@/app/**",
                                            "@/entities/*/*/**",
                                            "!@/entities/*/@x/*",
                                            "!@/entities/*/*/@x/*",
                                            "@/features/*/**",
                                            "!@/features/*/@x/*",
                                            "@/widgets/*/**",
                                            "!@/widgets/*/@x/*",
                                            "@/pages/*/**",
                                            "!@/pages/*/@x/*",
                                            "@/shared/api/**",
                                            "@/shared/live/**",
                                            "@/shared/prometheus/**",
                                            "@/shared/state/**",
                                            "@/shared/theme/**",
                                            "@/shared/utils/**",
                                            "@/shared/ui/*/**",
                                            "!@/shared/ui/charts/*"
                                        ],
                                        "message": "FSD public API: import a slice through its barrel ('@/entities/statistics/delivered', '@/shared/ui/button'), never a file inside it. Cross-slice imports on the same layer go through '@x'."
                                    },
                                    {
                                        "group": ["../../*", "../../**"],
                                        "message": "FSD: a relative import may not leave its own slice. Use the '@/<layer>/<slice>' barrel instead."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["src/widgets/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": ["@/app", "@/app/**", "@/pages", "@/pages/**"],
                                        "message": "FSD layer direction: app > pages > widgets > features > entities > shared. A layer may only import from layers below it."
                                    },
                                    {
                                        "group": ["@/widgets/**", "!@/widgets/*/@x/*"],
                                        "message": "FSD: slices on the same layer are isolated. Expose a cross-import API at '<slice>/@x/<consumer>.ts' and import that."
                                    },
                                    {
                                        "group": [
                                            "@/app/**",
                                            "@/entities/*/*/**",
                                            "!@/entities/*/@x/*",
                                            "!@/entities/*/*/@x/*",
                                            "@/features/*/**",
                                            "!@/features/*/@x/*",
                                            "@/widgets/*/**",
                                            "!@/widgets/*/@x/*",
                                            "@/pages/*/**",
                                            "!@/pages/*/@x/*",
                                            "@/shared/api/**",
                                            "@/shared/live/**",
                                            "@/shared/prometheus/**",
                                            "@/shared/state/**",
                                            "@/shared/theme/**",
                                            "@/shared/utils/**",
                                            "@/shared/ui/*/**",
                                            "!@/shared/ui/charts/*"
                                        ],
                                        "message": "FSD public API: import a slice through its barrel ('@/entities/statistics/delivered', '@/shared/ui/button'), never a file inside it. Cross-slice imports on the same layer go through '@x'."
                                    },
                                    {
                                        "group": ["../../*", "../../**"],
                                        "message": "FSD: a relative import may not leave its own slice. Use the '@/<layer>/<slice>' barrel instead."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["src/pages/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": ["@/app", "@/app/**"],
                                        "message": "FSD layer direction: app > pages > widgets > features > entities > shared. A layer may only import from layers below it."
                                    },
                                    {
                                        "group": ["@/pages/**", "!@/pages/*/@x/*"],
                                        "message": "FSD: slices on the same layer are isolated. Expose a cross-import API at '<slice>/@x/<consumer>.ts' and import that."
                                    },
                                    {
                                        "group": [
                                            "@/app/**",
                                            "@/entities/*/*/**",
                                            "!@/entities/*/@x/*",
                                            "!@/entities/*/*/@x/*",
                                            "@/features/*/**",
                                            "!@/features/*/@x/*",
                                            "@/widgets/*/**",
                                            "!@/widgets/*/@x/*",
                                            "@/pages/*/**",
                                            "!@/pages/*/@x/*",
                                            "@/shared/api/**",
                                            "@/shared/live/**",
                                            "@/shared/prometheus/**",
                                            "@/shared/state/**",
                                            "@/shared/theme/**",
                                            "@/shared/utils/**",
                                            "@/shared/ui/*/**",
                                            "!@/shared/ui/charts/*"
                                        ],
                                        "message": "FSD public API: import a slice through its barrel ('@/entities/statistics/delivered', '@/shared/ui/button'), never a file inside it. Cross-slice imports on the same layer go through '@x'."
                                    },
                                    {
                                        "group": ["../../*", "../../**"],
                                        "message": "FSD: a relative import may not leave its own slice. Use the '@/<layer>/<slice>' barrel instead."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["src/app/**", "app/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": [
                                            "@/app/**",
                                            "@/entities/*/*/**",
                                            "!@/entities/*/@x/*",
                                            "!@/entities/*/*/@x/*",
                                            "@/features/*/**",
                                            "!@/features/*/@x/*",
                                            "@/widgets/*/**",
                                            "!@/widgets/*/@x/*",
                                            "@/pages/*/**",
                                            "!@/pages/*/@x/*",
                                            "@/shared/api/**",
                                            "@/shared/live/**",
                                            "@/shared/prometheus/**",
                                            "@/shared/state/**",
                                            "@/shared/theme/**",
                                            "@/shared/utils/**",
                                            "@/shared/ui/*/**",
                                            "!@/shared/ui/charts/*"
                                        ],
                                        "message": "FSD public API: import a slice through its barrel ('@/entities/statistics/delivered', '@/shared/ui/button'), never a file inside it. Cross-slice imports on the same layer go through '@x'."
                                    },
                                    {
                                        "group": ["../../*", "../../**"],
                                        "message": "FSD: a relative import may not leave its own slice. Use the '@/<layer>/<slice>' barrel instead."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["**/src/shared/api/generated/**", "**/openapi.json"],
            "linter": {
                "enabled": false
            },
            "formatter": {
                "enabled": false
            },
            "assist": {
                "enabled": false
            }
        }
    ],
    "formatter": {
        "enabled": true,
        "lineWidth": 120,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "recommended": true,
                "organizeImports": {
                    "level": "on",
                    "options": {
                        "identifierOrder": "natural",
                        "groups": [
                            ["@tanstack/**"],
                            ":BLANK_LINE:",
                            ["react", "react-dom", "react-dom/**", "react-*"],
                            ":BLANK_LINE:",
                            [":BUN:", ":NODE:"],
                            ":BLANK_LINE:",
                            [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:"],
                            ":BLANK_LINE:",
                            ["@/app/**", "@/pages/**", "@/widgets/**", "@/features/**", "@/entities/**", "@/shared/**"],
                            ":BLANK_LINE:",
                            ":ALIAS:",
                            ":BLANK_LINE:",
                            ":PATH:",
                            ":BLANK_LINE:",
                            ":URL:",
                            "**"
                        ]
                    }
                }
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "useImportType": "off"
            },
            "nursery": {
                "useSortedClasses": {
                    "level": "on",
                    "fix": "safe",
                    "options": {
                        "attributes": ["classList"],
                        "functions": ["clsx", "cva", "cn", "tw", "tw.*"]
                    }
                }
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all",
            "semicolons": "asNeeded"
        }
    }
}
